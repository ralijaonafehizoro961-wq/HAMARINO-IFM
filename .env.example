# Copier : cp .env.example .env
DATABASE_PATH=./data/ifm.sqlite3
# Clé secrète obligatoire pour ajouter/synchroniser des sources
ADMIN_API_KEY=remplacer-par-une-cle-secrete-longue
# Optionnel: vérification tierce Google Fact Check Tools API
GOOGLE_FACTCHECK_API_KEY=
# Optionnel: analyse des affirmations avec OpenAI (sans clé: analyse heuristique locale)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Limite des domaines à interroger pour l'import de sources. * interdit en production.
MAX_UPLOAD_BYTES=8388608
MAX_FETCH_BYTES=1500000
